	FIELD k initialised Z
	FIELD l growthRate F
	FIELD m maxSize F
	FIELD n spreadThreshold F
	FIELD o size F
	FIELD p baseSize F
	FIELD q spreadTimer F
	FIELD r spreadDone Z
	FIELD s scratchPoint Landroid/graphics/Point;
