CLASS com/corrodinggames/rts/game/units/custom/f/a com/corrodinggames/rts/game/units/custom/variables/VariableReplacement
	COMMENT Static ${...} expansion pass over a unit's ini: Pattern "\\\\$\\\\{([^\\\\}]*)\\\\}" and identifier pattern "[A-Za-z_][A-Za-z_.0-9]*". Reads all [section]@global / @define keys into the variable maps, then rewrites every value containing "${". [evidence-based job name]
	FIELD a blockPattern Ljava/util/regex/Pattern;
	FIELD b identifierPattern Ljava/util/regex/Pattern;
	FIELD c sharedContext Lcom/corrodinggames/rts/game/units/custom/f/b;
	METHOD a expandVariables (Lcom/corrodinggames/rts/game/units/custom/l;Lcom/corrodinggames/rts/gameFramework/utility/ab;)V
