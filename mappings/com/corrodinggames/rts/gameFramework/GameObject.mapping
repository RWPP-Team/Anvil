	FIELD ei renderOrderComparator Lcom/corrodinggames/rts/gameFramework/x;
	FIELD ej removed Z
	FIELD em renderOrder I
	FIELD eo x F
	FIELD ep y F
	FIELD eq height F
	FIELD er fastGameObjectList Lcom/corrodinggames/rts/gameFramework/utility/s;
